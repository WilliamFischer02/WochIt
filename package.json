{
  "name": "wochit",
  "private": true,
  "version": "0.1.0",
  "description": "WochIt — watch a movie from one PC together, from anywhere, with synced play/pause/scrub, chat, GIFs and reactions.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm -r --parallel --filter @wochit/host --filter @wochit/web dev",
    "host": "pnpm --filter @wochit/host start",
    "e2e": "pnpm --filter @wochit/web e2e"
  }
}
