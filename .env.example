# Copy to .env (gitignored) on the host PC. Every value has a working default except the PIN,
# which the host prints at startup if unset.

# Port the host agent listens on (HTTP + WebSocket + HLS + the web app).
WOCHIT_PORT=8788

# Six-digit room PIN both of you type once. Leave empty to have one generated and printed.
WOCHIT_PIN=

# Where transcoded HLS segments, extracted subtitles and posters live. Put this on a roomy drive;
# a 2-hour film in four renditions is roughly 8 GB. Oldest media are evicted past the size cap.
WOCHIT_CACHE_DIR=./.cache
WOCHIT_CACHE_MAX_GB=60

# Folders the host may browse for media, separated by ";". Guests never see these paths.
WOCHIT_MEDIA_ROOTS=

# ffmpeg / ffprobe. Leave empty to search PATH and the winget install location.
WOCHIT_FFMPEG=
WOCHIT_FFPROBE=
# Video encoder: auto picks h264_nvenc > h264_qsv > h264_amf > libx264.
WOCHIT_ENCODER=auto

# VLC bridge (VLC's built-in HTTP interface, loopback only).
WOCHIT_VLC_EXE=
WOCHIT_VLC_HTTP_PORT=8089
WOCHIT_VLC_HTTP_PASSWORD=

# Tenor (Google) API key for GIF search. https://developers.google.com/tenor/guides/quickstart
TENOR_API_KEY=

# Optional: Tailscale IPs or hostnames (comma separated) that count as "the host PC" in addition
# to loopback and this machine's own interfaces. Normally unnecessary.
WOCHIT_HOST_ADDRS=
