{
  "name": "@wochit/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WochIt host agent: serves the web app, transcodes media to HLS on demand, bridges VLC, and runs the room (sync, chat, reactions).",
  "bin": {
    "wochit-host": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@wochit/shared": "workspace:*",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
